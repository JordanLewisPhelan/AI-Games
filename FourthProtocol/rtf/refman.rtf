00032 {\cf20 // Minimax algorithm}\par
00033 {\cf18 int} AIOpponent::miniMax(Board& t_board, {\cf18 int} t_depth, {\cf18 int} t_alpha, {\cf18 int} t_beta, {\cf18 bool} t_maximizingPlayer)\par
00034 \{\par
00035     {\cf20 // Return conditions}\par
00036     {\cf19 if} (t_depth == 0 || t_board.checkWin(Player::Player1) || t_board.checkWin(Player::Player2))\par
00037     \{\par
00038         {\cf19 return} evaluateBoard(t_board);\par
00039     \}\par
00040 \par
00041     Player l_currentPlayer = t_board.getCurrentPlayer();\par
00042     std::vector<AIMove> l_moves = getAllPossibleMoves(t_board, l_currentPlayer);\par
00043 \par
00044     {\cf19 if} (l_moves.empty())\par
00045     \{\par
00046         {\cf19 return} evaluateBoard(t_board);\par
00047     \}\par
00048 \par
00049     {\cf19 if} (t_maximizingPlayer)\par
00050     \{\par
00051         {\cf18 int} maxEval = std::numeric_limits<int>::min();\par
00052 \par
00053         {\cf19 for} ({\cf17 const} AIMove& move : l_moves)\par
00054         \{\par
00055             {\cf20 // Safeguarding current board state with a backup}\par
00056             Board::MoveBackup backup;\par
00057 \par
00058             {\cf19 if} (move.isInPlacement)\par
00059             \{\par
00060                 backup = t_board.simulatePlacement(move.pieceType, move.row, move.col, l_currentPlayer);\par
00061             \}\par
00062             {\cf19 else}\par
00063             \{\par
00064                 backup = t_board.simulateMove(move.fromRow, move.fromCol, move.toRow, move.toCol);\par
00065             \}\par
00066 \par
00067             {\cf20 // Begin Recursive Minimax loop}\par
00068             {\cf18 int} eval = miniMax(t_board, t_depth - 1, t_alpha, t_beta, {\cf17 false});\par
00069             maxEval = std::max(maxEval, eval);\par
00070 \par
00071             {\cf20 // Undo move after performing it}\par
00072             t_board.undoMove(backup);\par
00073 \par
00074             {\cf20 // Alpha-Beta pruning}\par
00075             t_alpha = std::max(t_alpha, eval);\par
00076             {\cf19 if} (t_beta <= t_alpha)\par
00077                 {\cf19 break}; {\cf20 // Prunes any remaining moves that stem from this stem}\par
00078         \}\par
00079         {\cf19 return} maxEval;\par
00080     \}\par
00081     {\cf19 else}\par
00082     \{\par
00083         {\cf18 int} minEval = std::numeric_limits<int>::max();\par
00084 \par
00085         {\cf19 for} ({\cf17 const} AIMove& move : l_moves)\par
00086         \{\par
00087             Board::MoveBackup backup;\par
00088             {\cf19 if} (move.isInPlacement) \{\par
00089                 backup = t_board.simulatePlacement(move.pieceType, move.row, move.col, l_currentPlayer);\par
00090             \}\par
00091             {\cf19 else} \{\par
00092                 backup = t_board.simulateMove(move.fromRow, move.fromCol, move.toRow, move.toCol);\par
00093             \}\par
00094 \par
00095             {\cf18 int} eval = miniMax(t_board, t_depth - 1, t_alpha, t_beta, {\cf17 true});\par
00096             minEval = std::min(minEval, eval);\par
00097 \par
00098             t_board.undoMove(backup);\par
00099 \par
00100             t_beta = std::min(t_beta, eval);\par
00101             {\cf19 if} (t_beta <= t_alpha) \{\par
00102                 {\cf19 break};\par
00103             \}\par
00104         \}\par
00105 \par
00106         {\cf19 return} minEval;\par
00107     \}\par
00108 \}\par
00109 \par
