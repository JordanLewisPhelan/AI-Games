00123 \par
00124 std::vector<std::pair<int, int>> Board::getDonkeyMoves({\cf18 int} row, {\cf18 int} col){\cf17  const}\par
00125 {\cf17 }\{\par
00126     std::vector<std::pair<int, int>> moves;\par
00127 \par
00128     {\cf20 // 4 directions: up, down, left, right}\par
00129     {\cf18 int} directions[4][2] = \{\par
00130         \{-1, 0\}, \{1, 0\}, \{0, -1\}, \{0, 1\}      {\cf20 // cardinal}\par
00131     \};\par
00132 \par
00133     {\cf19 for} ({\cf17 auto}& dir : directions) \par
00134     \{\par
00135         {\cf18 int} newRow = row + dir[0];\par
00136         {\cf18 int} newCol = col + dir[1];\par
00137 \par
00138         {\cf19 if} (isValidPosition(newRow, newCol) && m_grid[newRow][newCol].isEmpty()) \par
00139         \{\par
00140             moves.push_back(\{ newRow, newCol \});\par
00141         \}\par
00142     \}\par
00143 \par
00144     {\cf19 return} moves;\par
00145 \}\par
