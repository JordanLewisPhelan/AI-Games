00646 Board::MoveBackup Board::simulatePlacement(PieceType t_type, {\cf18 int} t_row, {\cf18 int} t_col, Player t_player)\par
00647 \{\par
00648     MoveBackup backup;\par
00649     backup.isPlacement = {\cf17 true};\par
00650     backup.placedType = t_type;\par
00651     backup.placedRow = t_row;\par
00652     backup.placedCol = t_col;\par
00653     backup.previousPlayer = m_currentPlayer;\par
00654     backup.wasPlacementPhase = m_placementPhase;\par
00655     backup.player1State = m_player1Pieces;\par
00656     backup.player2State = m_player2Pieces;\par
00657     backup.destinationPiece = m_grid[t_row][t_col];\par
00658 \par
00659     {\cf20 // Apply placement}\par
00660     m_grid[t_row][t_col] = Piece(t_type, t_player);\par
00661 \par
00662     {\cf20 // Decrement piece count}\par
00663     PlayerPieces& pieces = (t_player == Player::Player1) ? m_player1Pieces : m_player2Pieces;\par
00664     {\cf19 switch} (t_type) \{\par
00665     {\cf19 case} PieceType::Donkey: pieces.donkeys--; {\cf19 break};\par
00666     {\cf19 case} PieceType::Snake: pieces.snakes--; {\cf19 break};\par
00667     {\cf19 case} PieceType::Frog: pieces.frogs--; {\cf19 break};\par
00668     {\cf19 default}: {\cf19 break};\par
00669     \}\par
00670 \par
00671     {\cf20 // Check if placement complete}\par
00672     {\cf19 if} (m_player1Pieces.allPlaced() && m_player2Pieces.allPlaced()) \{\par
00673         m_placementPhase = {\cf17 false};\par
00674     \}\par
00675 \par
00676     {\cf20 // Switch player}\par
00677     m_currentPlayer = (m_currentPlayer == Player::Player1) ? Player::Player2 : Player::Player1;\par
00678 \par
00679     {\cf19 return} backup;\par
00680 \}\par
00681 \par
00682 Board::MoveBackup Board::simulateMove({\cf18 int} t_fromRow, {\cf18 int} t_fromCol, {\cf18 int} t_toRow, {\cf18 int} t_toCol)\par
00683 \{\par
00684     MoveBackup backup;\par
00685     backup.isPlacement = {\cf17 false};\par
00686     backup.fromRow = t_fromRow;\par
00687     backup.fromCol = t_fromCol;\par
00688     backup.toRow = t_toRow;\par
00689     backup.toCol = t_toCol;\par
00690     backup.movedPiece = m_grid[t_fromRow][t_fromCol];\par
00691     backup.destinationPiece = m_grid[t_toRow][t_toCol];\par
00692     backup.previousPlayer = m_currentPlayer;\par
00693     backup.wasPlacementPhase = m_placementPhase;\par
00694     backup.player1State = m_player1Pieces;\par
00695     backup.player2State = m_player2Pieces;\par
00696 \par
00697     {\cf20 // Apply movement}\par
00698     m_grid[t_toRow][t_toCol] = m_grid[t_fromRow][t_fromCol];\par
00699     m_grid[t_fromRow][t_fromCol] = Piece();\par
00700 \par
00701     {\cf20 // Switch player}\par
00702     m_currentPlayer = (m_currentPlayer == Player::Player1) ? Player::Player2 : Player::Player1;\par
00703 \par
00704     {\cf19 return} backup;\par
00705 \}\par
00706 \par
00707 {\cf18 void} Board::undoMove({\cf17 const} MoveBackup& t_backup)\par
00708 \{\par
00709     {\cf19 if} (t_backup.isPlacement) \{\par
00710         {\cf20 // Restore grid}\par
00711         m_grid[t_backup.placedRow][t_backup.placedCol] = t_backup.destinationPiece;\par
00712     \}\par
00713     {\cf19 else} \{\par
00714         {\cf20 // Restore movement}\par
00715         m_grid[t_backup.fromRow][t_backup.fromCol] = t_backup.movedPiece;\par
00716         m_grid[t_backup.toRow][t_backup.toCol] = t_backup.destinationPiece;\par
00717     \}\par
00718 \par
00719     {\cf20 // Restore all state}\par
00720     m_currentPlayer = t_backup.previousPlayer;\par
00721     m_placementPhase = t_backup.wasPlacementPhase;\par
00722     m_player1Pieces = t_backup.player1State;\par
00723     m_player2Pieces = t_backup.player2State;\par
00724 \}\par
