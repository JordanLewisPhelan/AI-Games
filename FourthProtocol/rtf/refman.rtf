00300 {\cf20 // ==================== WIN CHECKING ====================}\par
00301 \par
00302 {\cf18 bool} Board::checkDirection({\cf18 int} startRow, {\cf18 int} startCol, {\cf18 int} deltaRow, {\cf18 int} deltaCol, Player player){\cf17  const}\par
00303 {\cf17 }\{\par
00304     {\cf18 int} count = 0;\par
00305     {\cf18 int} row = startRow;\par
00306     {\cf18 int} col = startCol;\par
00307 \par
00308     {\cf20 // Check up to 4 in a row}\par
00309     {\cf19 while} (isValidPosition(row, col) && count < 4) \par
00310     \{\par
00311         {\cf17 const} Piece& piece = m_grid[row][col];\par
00312 \par
00313         {\cf20 // Early abort if not player's piece (alpha-beta pruning concept)}\par
00314         {\cf19 if} (piece.isEmpty() || piece.owner != player) \par
00315         \{\par
00316             {\cf19 return} {\cf17 false};\par
00317         \}\par
00318 \par
00319         count++;\par
00320         row += deltaRow;\par
00321         col += deltaCol;\par
00322     \}\par
00323 \par
00324     {\cf19 return} count == 4;\par
00325 \}\par
00326 \par
00327 {\cf18 bool} Board::checkWin(Player player){\cf17  const}\par
00328 {\cf17 }\{\par
00329     {\cf20 // Check all possible starting positions for 4-in-a-row}\par
00330 \par
00331     {\cf20 // Horizontal (check each row)}\par
00332     {\cf19 for} ({\cf18 int} row = 0; row < Globals::GRID_SIZE; ++row)\par
00333     \{\par
00334         {\cf19 for} ({\cf18 int} col = 0; col <= Globals::GRID_SIZE - 4; ++col)\par
00335         \{\par
00336             {\cf19 if} (checkDirection(row, col, 0, 1, player)) \par
00337             \{\par
00338                 {\cf19 return} {\cf17 true};\par
00339             \}\par
00340         \}\par
00341     \}\par
00342 \par
00343     {\cf20 // Vertical (check each column)}\par
00344     {\cf19 for} ({\cf18 int} col = 0; col < Globals::GRID_SIZE; ++col)\par
00345     \{\par
00346         {\cf19 for} ({\cf18 int} row = 0; row <= Globals::GRID_SIZE - 4; ++row)\par
00347         \{\par
00348             {\cf19 if} (checkDirection(row, col, 1, 0, player)) \par
00349             \{\par
00350                 {\cf19 return} {\cf17 true};\par
00351             \}\par
00352         \}\par
00353     \}\par
00354 \par
00355     {\cf20 // Diagonal (top-left to bottom-right)}\par
00356     {\cf19 for} ({\cf18 int} row = 0; row <= Globals::GRID_SIZE - 4; ++row)\par
00357     \{\par
00358         {\cf19 for} ({\cf18 int} col = 0; col <= Globals::GRID_SIZE - 4; ++col)\par
00359         \{\par
00360             {\cf19 if} (checkDirection(row, col, 1, 1, player))\par
00361             \{\par
00362                 {\cf19 return} {\cf17 true};\par
00363             \}\par
00364         \}\par
00365     \}\par
00366 \par
00367     {\cf20 // Diagonal (top-right to bottom-left)}\par
00368     {\cf19 for} ({\cf18 int} row = 0; row <= Globals::GRID_SIZE - 4; ++row)\par
00369     \{\par
00370         {\cf19 for} ({\cf18 int} col = 3; col < Globals::GRID_SIZE; ++col)\par
00371         \{\par
00372             {\cf19 if} (checkDirection(row, col, 1, -1, player))\par
00373             \{\par
00374                 {\cf19 return} {\cf17 true};\par
00375             \}\par
00376         \}\par
00377     \}\par
00378 \par
00379     {\cf19 return} {\cf17 false};\par
00380 \}\par
