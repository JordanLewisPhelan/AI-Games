00619         {\cf18 float} dist = std::sqrt(std::pow(screenPos.x - snakePos.x, 2) + std::pow(screenPos.y - snakePos.y, 2));\par
00620         {\cf19 if} (dist < clickRadius) {\cf19 return} PieceType::Snake;\par
00621         yOffset += spacing;\par
00622     \}\par
00623 \par
00624     {\cf20 // Check Frog}\par
00625     {\cf19 if} (pieces.frogs > 0)\par
00626     \{\par
00627         sf::Vector2f frogPos(Globals::UNPLACED_PANEL_X + 30.f, yOffset + 30.f);\par
