00407 \par
00408 {\cf18 void} Board::drawPieces(sf::RenderWindow& window, sf::Vector2f position){\cf17  const}\par
00409 {\cf17 }\{\par
00410     {\cf19 for} ({\cf18 int} row = 0; row < Globals::GRID_SIZE; ++row)\par
00411     \{\par
00412         {\cf19 for} ({\cf18 int} col = 0; col < Globals::GRID_SIZE; ++col)\par
00413         \{\par
00414             {\cf17 const} Piece& piece = m_grid[row][col];\par
00415             {\cf19 if} (!piece.isEmpty()) \par
00416             \{\par
00417                 {\cf18 float} x = position.x + col * Globals::CELL_SIZE + Globals::CELL_SIZE / 2.f;\par
00418                 {\cf18 float} y = position.y + row * Globals::CELL_SIZE + Globals::CELL_SIZE / 2.f;\par
00419 \par
00420                 {\cf20 // Draw different shapes for different piece types}\par
00421                 sf::Color color = getPieceColor(piece.type, piece.owner);\par
00422 \par
00423                 {\cf19 switch} (piece.type) \par
00424                 \{\par
00425                 {\cf19 case} PieceType::Donkey: \par
00426                 \{\par
00427                     {\cf20 // Circle for Donkey}\par
00428                     sf::CircleShape shape(Globals::CELL_SIZE * 0.35f);\par
00429                     shape.setOrigin(sf::Vector2f(Globals::CELL_SIZE * 0.35f, Globals::CELL_SIZE * 0.35f));\par
00430                     shape.setPosition(sf::Vector2f(x, y));\par
