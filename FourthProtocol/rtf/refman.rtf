00399             cell.setPosition(sf::Vector2f(position.x + col * Globals::CELL_SIZE, position.y + row * Globals::CELL_SIZE));\par
00400             cell.setFillColor(sf::Color(60, 60, 60));\par
00401             cell.setOutlineColor(sf::Color::White);\par
00402             cell.setOutlineThickness(2.f);\par
