00344 {\cf18 void} GamePlayState::handlePauseInput({\cf17 const} sf::Event& t_event)\par
00345 \{\par
00346     {\cf20 // Handle mouse movement for hover}\par
00347     {\cf19 if} ({\cf17 const} {\cf17 auto}* mouseMove = t_event.getIf<sf::Event::MouseMoved>())\par
