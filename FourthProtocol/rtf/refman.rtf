00147 std::vector<std::pair<int, int>> Board::getSnakeMoves({\cf18 int} row, {\cf18 int} col){\cf17  const}\par
00148 {\cf17 }\{\par
00149     std::vector<std::pair<int, int>> moves;\par
00150 \par
00151     {\cf20 // 4 diagonal directions only}\par
00152     {\cf18 int} directions[4][2] = \{\par
00153         \{-1, -1\}, \{-1, 1\}, \{1, -1\}, \{1, 1\}\par
00154     \};\par
00155 \par
00156     {\cf19 for} ({\cf17 auto}& dir : directions) \par
00157     \{\par
00158         {\cf18 int} newRow = row + dir[0];\par
00159         {\cf18 int} newCol = col + dir[1];\par
00160 \par
00161         {\cf19 if} (isValidPosition(newRow, newCol) && m_grid[newRow][newCol].isEmpty()) \par
00162         \{\par
00163             moves.push_back(\{ newRow, newCol \});\par
00164         \}\par
00165     \}\par
00166 \par
00167     {\cf19 return} moves;\par
00168 \}\par
00169 \par
00170 std::vector<std::pair<int, int>> Board::getFrogMoves({\cf18 int} row, {\cf18 int} col){\cf17  const}\par
00171 {\cf17 }\{\par
00172     std::vector<std::pair<int, int>> moves;\par
00173 \par
00174     {\cf20 // 8 directions (can jump in any direction)}\par
00175     {\cf18 int} directions[8][2] = \{\par
00176         \{-1, 0\}, \{1, 0\}, \{0, -1\}, \{0, 1\},      {\cf20 // orthogonal}\par
00177         \{-1, -1\}, \{-1, 1\}, \{1, -1\}, \{1, 1\}     {\cf20 // diagonal}\par
00178     \};\par
00179 \par
00180     {\cf19 for} ({\cf17 auto}& dir : directions) \par
00181     \{\par
00182         {\cf18 int} adjacentRow = row + dir[0];\par
00183         {\cf18 int} adjacentCol = col + dir[1];\par
00184 \par
00185         {\cf19 if} (isValidPosition(adjacentRow, adjacentCol) && m_grid[adjacentRow][adjacentCol].isEmpty())\par
00186         \{\par
00187             moves.push_back(\{ adjacentRow, adjacentCol \});\par
00188         \}\par
00189 \par
00190         {\cf20 // Check if there's a piece adjacent (to jump over)}\par
00191         {\cf19 if} (isValidPosition(adjacentRow, adjacentCol) && !m_grid[adjacentRow][adjacentCol].isEmpty()) \par
00192         \{\par
00193             {\cf18 int} landRow;\par
00194             {\cf18 int} landCol;\par
00195 \par
00196             {\cf19 for} ({\cf18 int} i = 2; i < Globals::GRID_SIZE; i++)\par
00197             \{\par
00198                 {\cf20 // Check landing spot (2 or further spaces away)}\par
00199                 landRow = row + dir[0] * i;\par
00200                 landCol = col + dir[1] * i;\par
00201 \par
00202                 {\cf19 if} (isValidPosition(landRow, landCol) && m_grid[landRow][landCol].isEmpty())\par
00203                 \{\par
00204                     moves.push_back(\{ landRow, landCol \});\par
00205                     {\cf19 break};  {\cf20 // Prevents frog being able to jump over more than 1 empty space}\par
00206                 \}\par
00207             \}\par
00208         \}\par
00209     \}\par
00210 \par
00211     {\cf19 return} moves;\par
00212 \}\par
00213 \par
00214 std::vector<std::pair<int, int>> Board::getValidMoves({\cf18 int} row, {\cf18 int} col){\cf17  const}\par
00215 {\cf17 }\{\par
00216     {\cf19 if} (m_placementPhase) {\cf19 return} \{\};\par
00217     {\cf19 if} (!isValidPosition(row, col)) {\cf19 return} \{\};\par
00218 \par
00219     {\cf17 const} Piece& piece = m_grid[row][col];\par
00220     {\cf19 if} (piece.isEmpty()) {\cf19 return} \{\};\par
00221     {\cf19 if} (piece.owner != m_currentPlayer) {\cf19 return} \{\};\par
00222 \par
00223     {\cf19 switch} (piece.type) \par
00224     \{\par
00225     {\cf19 case} PieceType::Donkey: {\cf19 return} getDonkeyMoves(row, col);\par
00226     {\cf19 case} PieceType::Snake: {\cf19 return} getSnakeMoves(row, col);\par
00227     {\cf19 case} PieceType::Frog: {\cf19 return} getFrogMoves(row, col);\par
00228     {\cf19 default}: {\cf19 return} \{\};\par
00229     \}\par
00230 \}\par
00231 \par
00232 {\cf18 bool} Board::selectPieceForMove({\cf18 int} row, {\cf18 int} col)\par
00233 \{\par
00234     {\cf19 if} (m_placementPhase) {\cf19 return} {\cf17 false};\par
00235     {\cf19 if} (!isValidPosition(row, col)) {\cf19 return} {\cf17 false};\par
00236 \par
00237     {\cf17 const} Piece& piece = m_grid[row][col];\par
00238     {\cf19 if} (piece.isEmpty()) {\cf19 return} {\cf17 false};\par
00239     {\cf19 if} (piece.owner != m_currentPlayer) {\cf19 return} {\cf17 false};\par
00240 \par
00241     {\cf20 // Check if piece has valid moves}\par
00242     {\cf17 auto} moves = getValidMoves(row, col);\par
00243     {\cf19 if} (moves.empty())\par
00244     \{\par
00245         std::cout << {\cf22 "Piece at ("} << row << {\cf22 ", "} << col << {\cf22 ") has no valid moves\\n"};\par
00246         {\cf19 return} {\cf17 false};\par
00247     \}\par
00248 \par
00249     m_selectedRow = row;\par
00250     m_selectedCol = col;\par
00251     m_pieceSelected = {\cf17 true};\par
00252 \par
00253     std::cout << {\cf22 "Selected piece at ("} << row << {\cf22 ", "} << col << {\cf22 ") with "} << moves.size() << {\cf22 " valid moves\\n"};\par
00254     {\cf19 return} {\cf17 true};\par
00255 \}\par
00256 \par
00257 {\cf18 bool} Board::movePiece({\cf18 int} toRow, {\cf18 int} toCol)\par
00258 \{\par
00259     {\cf19 if} (!m_pieceSelected) {\cf19 return} {\cf17 false};\par
00260     {\cf19 if} (!isValidPosition(toRow, toCol)) {\cf19 return} {\cf17 false};\par
00261 \par
00262     {\cf20 // Check if target is a valid move}\par
00263     {\cf17 auto} validMoves = getValidMoves(m_selectedRow, m_selectedCol);\par
00264     {\cf18 bool} isValidMove = {\cf17 false};\par
00265     {\cf19 for} ({\cf17 const} {\cf17 auto}& move : validMoves) \par
00266     \{\par
00267         {\cf19 if} (move.first == toRow && move.second == toCol)\par
00268         \{\par
00269             isValidMove = {\cf17 true};\par
00270             {\cf19 break};\par
00271         \}\par
00272     \}\par
00273 \par
00274     {\cf19 if} (!isValidMove) \par
00275     \{\par
00276         std::cout << {\cf22 "Invalid move to ("} << toRow << {\cf22 ", "} << toCol << {\cf22 ")\\n"};\par
00277         {\cf19 return} {\cf17 false};\par
00278     \}\par
00279 \par
00280     {\cf20 // Move the piece}\par
00281     m_grid[toRow][toCol] = m_grid[m_selectedRow][m_selectedCol];\par
00282     m_grid[m_selectedRow][m_selectedCol] = Piece();\par
00283 \par
00284     std::cout << {\cf22 "Moved piece from ("} << m_selectedRow << {\cf22 ", "} << m_selectedCol << {\cf22 ") to ("} << toRow << {\cf22 ", "} << toCol << {\cf22 ")\\n"};\par
00285 \par
00286     {\cf20 // Deselect and switch player}\par
00287     deselectPiece();\par
00288     switchPlayer();\par
00289 \par
00290     {\cf19 return} {\cf17 true};\par
00291 \}\par
