00481 {\cf18 void} GamePlayState::executeAIMove()\par
00482 \{\par
00483     {\cf19 if} (!m_ai || m_aiIsThinking) {\cf19 return};\par
00484 \par
00485     m_aiIsThinking = {\cf17 true};\par
00486     std::cout << {\cf22 "=== AI TURN ==="} << {\cf22 "\\n"};\par
