00125 std::vector<AIMove> AIOpponent::getPlacementMoves({\cf17 const} Board& t_board, Player t_player){\cf17  const}\par
00126 {\cf17 }\{\par
00127     std::vector<AIMove> l_moves;\par
00128 \par
00129     {\cf20 // Check what pieces this player has available}\par
00130     std::vector<PieceType> l_availableTypes;\par
00131     {\cf19 if} (t_board.getRemainingPieceCount(t_player, PieceType::Donkey) > 0)\par
00132     \{\par
00133         l_availableTypes.push_back(PieceType::Donkey);\par
00134     \}\par
00135     {\cf19 if} (t_board.getRemainingPieceCount(t_player, PieceType::Snake) > 0) \par
00136     \{\par
00137         l_availableTypes.push_back(PieceType::Snake);\par
00138     \}\par
00139     {\cf19 if} (t_board.getRemainingPieceCount(t_player, PieceType::Frog) > 0) \par
00140     \{\par
00141         l_availableTypes.push_back(PieceType::Frog);\par
00142     \}\par
00143 \par
00144     {\cf20 // Try placing each available piece type at each empty position}\par
00145     {\cf19 for} ({\cf18 int} row = 0; row < Globals::GRID_SIZE; ++row)\par
00146     \{\par
00147         {\cf19 for} ({\cf18 int} col = 0; col < Globals::GRID_SIZE; ++col)\par
00148         \{\par
00149             {\cf19 for} (PieceType type : l_availableTypes) \par
00150             \{\par
00151                 {\cf19 if} (t_board.canPlacePiece(row, col, type, t_player)) \par
00152                 \{\par
00153                     l_moves.push_back(AIMove::createPlacement(type, row, col));\par
00154                 \}\par
00155             \}\par
00156         \}\par
00157     \}\par
00158 \par
00159     {\cf19 return} l_moves;\par
00160 \}\par
00161 \par
00162 std::vector<AIMove> AIOpponent::getMovementMoves({\cf17 const} Board& t_board, Player t_player){\cf17  const}\par
00163 {\cf17 }\{\par
00164     std::vector<AIMove> l_moves;\par
00165 \par
00166     {\cf20 // Find all pieces owned by this player}\par
00167     {\cf19 for} ({\cf18 int} row = 0; row < Globals::GRID_SIZE; ++row) \par
00168     \{\par
00169         {\cf19 for} ({\cf18 int} col = 0; col < Globals::GRID_SIZE; ++col)\par
00170         \{\par
00171             {\cf17 const} Piece& l_piece = t_board.getPiece(row, col);\par
00172 \par
00173             {\cf19 if} (!l_piece.isEmpty() && l_piece.owner == t_player)\par
00174             \{\par
00175                 {\cf20 // Get valid moves for this piece}\par
00176                 {\cf17 auto} validMoves = t_board.getValidMoves(row, col);\par
00177 \par
00178                 {\cf19 for} ({\cf17 const} {\cf17 auto}& [toRow, toCol] : validMoves) \par
00179                 \{\par
00180                     l_moves.push_back(AIMove::createMovement(row, col, toRow, toCol));\par
00181                 \}\par
00182             \}\par
00183         \}\par
00184     \}\par
00185 \par
00186     {\cf19 return} l_moves;\par
00187 \}\par
