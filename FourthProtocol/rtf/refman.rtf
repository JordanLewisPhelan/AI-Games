00060 {\cf18 bool} Board::canPlacePiece({\cf18 int} row, {\cf18 int} col, PieceType type, Player player){\cf17  const}\par
00061 {\cf17 }\{\par
00062     {\cf19 if} (!m_placementPhase) {\cf19 return} {\cf17 false};\par
00063     {\cf19 if} (player != m_currentPlayer) {\cf19 return} {\cf17 false};\par
00064     {\cf19 if} (!isValidPosition(row, col)) {\cf19 return} {\cf17 false};\par
00065     {\cf19 if} (!m_grid[row][col].isEmpty()) {\cf19 return} {\cf17 false};\par
00066     {\cf19 if} (type == PieceType::None) {\cf19 return} {\cf17 false};\par
00067 \par
00068     {\cf20 // Check if player has this piece available}\par
00069     {\cf17 const} PlayerPieces& pieces = (player == Player::Player1) ? m_player1Pieces : m_player2Pieces;\par
00070     {\cf19 return} pieces.getPieceCount(type) > 0;\par
00071 \}\par
00072 \par
00073 {\cf18 bool} Board::placePiece({\cf18 int} row, {\cf18 int} col, PieceType type, Player player)\par
00074 \{\par
00075     {\cf19 if} (!canPlacePiece(row, col, type, player)) \{\par
00076         {\cf19 return} {\cf17 false};\par
00077     \}\par
00078 \par
00079     {\cf20 // Place the piece}\par
00080     m_grid[row][col] = Piece(type, player);\par
00081 \par
00082     {\cf20 // Decrement piece count}\par
00083     PlayerPieces& pieces = (player == Player::Player1) ? m_player1Pieces : m_player2Pieces;\par
00084 \par
00085     {\cf19 switch} (type)\par
00086     \{\par
00087     {\cf19 case} PieceType::Donkey: pieces.donkeys--; {\cf19 break};\par
00088     {\cf19 case} PieceType::Snake: pieces.snakes--; {\cf19 break};\par
00089     {\cf19 case} PieceType::Frog: pieces.frogs--; {\cf19 break};\par
00090     {\cf19 default}: {\cf19 break};\par
00091     \}\par
00092 \par
00093     std::cout << {\cf22 "Placed "} << (int)type << {\cf22 " for "} << ({\cf18 int})player << {\cf22 " at ("} << row << {\cf22 ", "} << col << {\cf22 ")\\n"};\par
00094 \par
00095     {\cf20 // Check if placement phase is complete}\par
00096     {\cf19 if} (m_player1Pieces.allPlaced() && m_player2Pieces.allPlaced()) \par
00097     \{\par
00098         m_placementPhase = {\cf17 false};\par
00099         m_currentPlayer = Player::Player1; {\cf20 // P1 starts movement phase}\par
00100         std::cout << {\cf22 "Placement complete! Movement phase begins.\\n"};\par
00101     \}\par
00102     {\cf19 else} \par
00103     \{\par
00104         {\cf20 // Switch player}\par
00105         switchPlayer();\par
00106     \}\par
00107 \par
00108     {\cf19 return} {\cf17 true};\par
00109 \}\par
