00392 {\cf18 void} Board::drawGrid(sf::RenderWindow& window, sf::Vector2f position){\cf17  const}\par
00393 {\cf17 }\{\par
00394     {\cf19 for} ({\cf18 int} row = 0; row < Globals::GRID_SIZE; ++row)\par
