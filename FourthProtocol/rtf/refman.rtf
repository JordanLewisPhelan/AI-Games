\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid 00001 {\cf21 #include "NetworkManager.h"}\par
00002 {\cf21 #include <iostream>}\par
00003 \par
00004 NetworkManager::NetworkManager()\par
00005     : m_isHost(false)\par
00006     , m_connectionState(ConnectionState::Idle)\par
00007 \{\par
00008 \}\par
00009 \par
00010 NetworkManager::~NetworkManager()\par
00011 \{\par
00012     disconnect();\par
00013 \}\par
00014 \par
00015 {\cf18 void} NetworkManager::setNonBlocking({\cf18 bool} t_nonBlocking)\par
00016 \{\par
00017     m_socket.setBlocking(!t_nonBlocking);\par
00018 \}\par
00019 \par
00020 {\cf18 bool} NetworkManager::startHostAsync({\cf18 unsigned} {\cf18 short} t_port)\par
00021 \{\par
00022     std::cout << {\cf22 "[NetworkManager] Starting host on port "} << t_port << {\cf22 "\\n"};\par
00023 \par
00024     m_isHost = {\cf17 true};\par
00025 \par
00026     {\cf20 // Bind listener to port}\par
00027     {\cf19 if} (m_listener.listen(t_port) != sf::Socket::Status::Done) \{\par
00028         std::cout << {\cf22 "[NetworkManager] ERROR: Could not bind to port "} << t_port << {\cf22 "\\n"};\par
00029         m_connectionState = ConnectionState::Failed;\par
00030         {\cf19 return} {\cf17 false};\par
00031     \}\par
00032 \par
00033     {\cf20 // Make listener non-blocking so accept() doesn't freeze the game}\par
00034     m_listener.setBlocking({\cf17 false});\par
00035 \par
00036     std::cout << {\cf22 "[NetworkManager] Listening on port "} << t_port << {\cf22 "...\\n"};\par
00037     m_connectionState = ConnectionState::Listening;\par
00038 \par
00039     {\cf19 return} {\cf17 true};\par
00040 \}\par
00041 \par
00042 {\cf18 bool} NetworkManager::connectAsClientAsync({\cf17 const} std::string& t_ip, {\cf18 unsigned} {\cf18 short} t_port)\par
00043 \{\par
00044     std::cout << {\cf22 "[NetworkManager] Connecting to "} << t_ip << {\cf22 ":"} << t_port << {\cf22 "\\n"};\par
00045 \par
00046     m_isHost = {\cf17 false};\par
00047 \par
00048     {\cf20 // Resolve IP address}\par
00049     {\cf17 auto} addressOpt = sf::IpAddress::resolve(t_ip);\par
00050     {\cf19 if} (!addressOpt.has_value())\par
00051     \{\par
00052         std::cout << {\cf22 "[NetworkManager] ERROR: Invalid IP address: "} << t_ip << {\cf22 "\\n"};\par
00053         m_connectionState = ConnectionState::Failed;\par
00054         {\cf19 return} {\cf17 false};\par
00055     \}\par
00056 \par
00057     sf::IpAddress address = addressOpt.value();\par
00058 \par
00059     {\cf20 // Set socket non-blocking BEFORE connecting}\par
00060     m_socket.setBlocking({\cf17 false});\par
00061 \par
00062     m_connectionState = ConnectionState::Connecting;\par
00063 \par
00064     {\cf20 // Attempt connection (returns immediately in non-blocking mode)}\par
00065     sf::Socket::Status status = m_socket.connect(address, t_port);\par
00066 \par
00067     {\cf19 if} (status == sf::Socket::Status::Done) \par
00068     \{\par
00069         {\cf20 // Connected immediately (rare, but possible on localhost)}\par
00070         std::cout << {\cf22 "[NetworkManager] Connected immediately!\\n"};\par
00071         m_connectionState = ConnectionState::Connected;\par
00072         {\cf19 return} {\cf17 true};\par
00073     \}\par
00074     {\cf19 else} {\cf19 if} (status == sf::Socket::Status::NotReady)\par
00075     \{\par
00076         {\cf20 // Connection in progress (normal for non-blocking)}\par
00077         std::cout << {\cf22 "[NetworkManager] Connection in progress...\\n"};\par
00078         {\cf19 return} {\cf17 true};  {\cf20 // Not failed, just pending}\par
00079     \}\par
00080     {\cf19 else} \par
00081     \{\par
00082         {\cf20 // Connection failed}\par
00083         std::cout << {\cf22 "[NetworkManager] ERROR: Connection failed\\n"};\par
00084         m_connectionState = ConnectionState::Failed;\par
00085         {\cf19 return} {\cf17 false};\par
00086     \}\par
00087 \}\par
00088 \par
00089 {\cf18 void} NetworkManager::updateConnection()\par
00090 \{\par
00091     {\cf19 if} (m_connectionState == ConnectionState::Listening) \par
00092     \{\par
00093         {\cf20 // Host: Check if client connected}\par
00094         sf::Socket::Status status = m_listener.accept(m_socket);\par
00095 \par
00096         {\cf19 if} (status == sf::Socket::Status::Done) \par
00097         \{\par
00098             std::cout << {\cf22 "[NetworkManager] Client connected!\\n"};\par
00099             m_socket.setBlocking({\cf17 false});  {\cf20 // Make socket non-blocking}\par
00100             m_connectionState = ConnectionState::Connected;\par
00101         \}\par
00102         {\cf19 else} {\cf19 if} (status == sf::Socket::Status::Error)\par
00103         \{\par
00104             std::cout << {\cf22 "[NetworkManager] ERROR: Accept failed\\n"};\par
00105             m_connectionState = ConnectionState::Failed;\par
00106         \}\par
00107         {\cf20 // Status::NotReady means no connection yet (normal)}\par
00108     \}\par
00109     {\cf19 else} {\cf19 if} (m_connectionState == ConnectionState::Connecting)\par
00110     \{\par
00111         {\cf20 // Client: Check if connection completed}\par
00112         {\cf20 // Try sending a test packet to check if connected}\par
00113         sf::Packet testPacket;\par
00114         testPacket << std::string({\cf22 "PING"});\par
00115 \par
00116         sf::Socket::Status status = m_socket.send(testPacket);\par
00117 \par
00118         {\cf19 if} (status == sf::Socket::Status::Done)\par
00119         \{\par
00120             std::cout << {\cf22 "[NetworkManager] Connection established!\\n"};\par
00121             m_connectionState = ConnectionState::Connected;\par
00122         \}\par
00123         {\cf19 else} {\cf19 if} (status == sf::Socket::Status::Error || status == sf::Socket::Status::Disconnected) \par
00124         \{\par
00125             std::cout << {\cf22 "[NetworkManager] Connection failed\\n"};\par
00126             m_connectionState = ConnectionState::Failed;\par
00127         \}\par
00128         {\cf20 // Status::NotReady means still connecting}\par
00129     \}\par
00130 \}\par
00131 \par
00132 {\cf18 bool} NetworkManager::sendMessage({\cf17 const} std::string& message)\par
00133 \{\par
00134     {\cf19 if} (m_connectionState != ConnectionState::Connected)\par
00135     \{\par
00136         std::cout << {\cf22 "[NetworkManager] ERROR: Not connected, cannot send\\n"};\par
00137         {\cf19 return} {\cf17 false};\par
00138     \}\par
00139 \par
00140     sf::Packet packet;\par
00141     packet << message;\par
00142 \par
00143     sf::Socket::Status status = m_socket.send(packet);\par
00144 \par
00145     {\cf19 if} (status == sf::Socket::Status::Done) \par
00146     \{\par
00147         std::cout << {\cf22 "[NetworkManager] Sent: "} << message << {\cf22 "\\n"};\par
00148         {\cf19 return} {\cf17 true};\par
00149     \}\par
00150     {\cf19 else} {\cf19 if} (status == sf::Socket::Status::Disconnected)\par
00151     \{\par
00152         std::cout << {\cf22 "[NetworkManager] Connection lost while sending\\n"};\par
00153         m_connectionState = ConnectionState::Failed;\par
00154         {\cf19 return} {\cf17 false};\par
00155     \}\par
00156     {\cf19 else}\par
00157     \{\par
00158         std::cout << {\cf22 "[NetworkManager] ERROR: Failed to send message\\n"};\par
00159         {\cf19 return} {\cf17 false};\par
00160     \}\par
00161 \}\par
00162 \par
00163 std::optional<std::string> NetworkManager::receiveMessage()\par
00164 \{\par
00165     {\cf19 if} (m_connectionState != ConnectionState::Connected)\par
00166     \{\par
00167         {\cf19 return} std::nullopt;\par
00168     \}\par
00169 \par
00170     sf::Packet packet;\par
00171     sf::Socket::Status status = m_socket.receive(packet);\par
00172 \par
00173     {\cf19 if} (status == sf::Socket::Status::Done) \par
00174     \{\par
00175         std::string message;\par
00176         packet >> message;\par
00177         std::cout << {\cf22 "[NetworkManager] Received: "} << message << {\cf22 "\\n"};\par
00178         {\cf19 return} message;\par
00179     \}\par
00180     {\cf19 else} {\cf19 if} (status == sf::Socket::Status::Disconnected) \par
00181     \{\par
00182         std::cout << {\cf22 "[NetworkManager] Connection lost\\n"};\par
00183         m_connectionState = ConnectionState::Failed;\par
00184         {\cf19 return} std::nullopt;\par
00185     \}\par
00186     {\cf19 else} {\cf19 if} (status == sf::Socket::Status::NotReady)\par
00187     \{\par
00188         {\cf20 // No data available (normal in non-blocking mode)}\par
00189         {\cf19 return} std::nullopt;\par
00190     \}\par
00191     {\cf19 else} \{\par
00192         {\cf20 // Error}\par
00193         std::cout << {\cf22 "[NetworkManager] ERROR: Socket error\\n"};\par
00194         {\cf19 return} std::nullopt;\par
00195     \}\par
00196 \}\par
00197 \par
00198 {\cf18 void} NetworkManager::disconnect()\par
00199 \{\par
00200     {\cf19 if} (m_connectionState != ConnectionState::Idle) \par
00201     \{\par
00202         std::cout << {\cf22 "[NetworkManager] Disconnecting...\\n"};\par
00203         m_socket.disconnect();\par
00204         m_connectionState = ConnectionState::Idle;\par
00205     \}\par
00206 \par
00207     {\cf19 if} (m_isHost) \par
00208     \{\par
00209         m_listener.close();\par
00210     \}\par
00211 \}\par
}
