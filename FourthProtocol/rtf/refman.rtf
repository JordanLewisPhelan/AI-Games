00214             m_currentHover = ButtonHover::Quit;\par
00215         \}\par
00216         {\cf20 // Check what difficulty is being hovered over}\par
00217         {\cf19 else} {\cf19 if} (isMouseOverRectShape(m_easyButton, mousePos)) \{\par
00218             m_currentHover = ButtonHover::Easy;\par
00219         \}\par
00220         {\cf19 else} {\cf19 if} (isMouseOverRectShape(m_mediumButton, mousePos)) \{\par
00221             m_currentHover = ButtonHover::Medium;\par
00222         \}\par
00223         {\cf19 else} {\cf19 if} (isMouseOverRectShape(m_hardButton, mousePos)) \{\par
00224             m_currentHover = ButtonHover::Hard;\par
00225         \}\par
00226         {\cf19 else} \{\par
00227             m_currentHover = ButtonHover::None;\par
00228         \}\par
00229     \}\par
00230 \par
00231     {\cf20 // Handle mouse clicks}\par
00232     {\cf19 if} ({\cf17 const} {\cf17 auto}* mousePress = t_event.getIf<sf::Event::MouseButtonPressed>())\par
00233     \{\par
00234         {\cf19 if} (mousePress->button == sf::Mouse::Button::Left)\par
00235         \{\par
00236             sf::Vector2f mousePos({\cf17 static_cast<}{\cf18 float}{\cf17 >}(mousePress->position.x),\par
