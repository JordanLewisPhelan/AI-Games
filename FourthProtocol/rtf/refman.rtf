00006 LobbyState::LobbyState(sf::Font *t_font, std::shared_ptr<NetworkManager> t_networkManager, {\cf18 bool} t_isHost)\par
00007     : GameState(t_font)\par
00008     , m_networkManager(t_networkManager)\par
00009     , m_isHost(t_isHost)\par
00010     , m_titleText(*m_sharedFont)\par
00011     , m_statusText(*m_sharedFont)\par
