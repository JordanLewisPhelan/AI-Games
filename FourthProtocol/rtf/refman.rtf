00432                     window.draw(shape);\par
00433                     {\cf19 break};\par
00434                 \}\par
00435                 {\cf19 case} PieceType::Snake: \par
00436                 \{\par
00437                     {\cf20 // Triangle for Snake}\par
00438                     sf::CircleShape shape(Globals::CELL_SIZE * 0.35f, 3);\par
00439                     shape.setOrigin(sf::Vector2f(Globals::CELL_SIZE * 0.35f, Globals::CELL_SIZE * 0.35f));\par
00440                     shape.setPosition(sf::Vector2f(x, y));\par
00441                     shape.setFillColor(color);\par
00442                     window.draw(shape);\par
00443                     {\cf19 break};\par
00444                 \}\par
00445                 {\cf19 case} PieceType::Frog: \par
00446                 \{\par
00447                     {\cf20 // Square for Frog}\par
00448                     sf::RectangleShape shape(sf::Vector2f(Globals::CELL_SIZE * 0.6f, Globals::CELL_SIZE * 0.6f));\par
00449                     shape.setOrigin(sf::Vector2f(Globals::CELL_SIZE * 0.3f, Globals::CELL_SIZE * 0.3f));\par
00450                     shape.setPosition(sf::Vector2f(x, y));\par
00451                     shape.setFillColor(color);\par
00452                     window.draw(shape);\par
00453                     {\cf19 break};\par
00454                 \}\par
00455                 {\cf19 default}: {\cf19 break};\par
00456                 \}\par
00457 \par
00458                 {\cf20 // Highlight selected piece}\par
00459                 {\cf19 if} (m_pieceSelected && row == m_selectedRow && col == m_selectedCol) \par
00460                 \{\par
00461                     sf::CircleShape highlight(Globals::CELL_SIZE * 0.45f);\par
00462                     highlight.setOrigin(sf::Vector2f(Globals::CELL_SIZE * 0.45f, Globals::CELL_SIZE * 0.45f));\par
00463                     highlight.setPosition(sf::Vector2f(x, y));\par
00464                     highlight.setFillColor(sf::Color::Transparent);\par
00465                     highlight.setOutlineColor(sf::Color::Yellow);\par
00466                     highlight.setOutlineThickness(3.f);\par
00467                     window.draw(highlight);\par
00468                 \}\par
00469             \}\par
00470         \}\par
00471     \}\par
00472 \}\par
00473 \par
00474 {\cf18 void} Board::drawUnplacedPieces(sf::RenderWindow& window, Player player, sf::Font& font){\cf17  const}\par
00475 {\cf17 }\{\par
00476     {\cf19 if} (!m_placementPhase) {\cf19 return};\par
00477     {\cf19 if} (player != m_currentPlayer) {\cf19 return};\par
