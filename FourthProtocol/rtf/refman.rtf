00190 {\cf20 // ==================== EVALUATION ====================}\par
00191 \par
00192 {\cf18 int} AIOpponent::evaluateBoard(Board& t_board)\par
00193 \{\par
00194     {\cf19 if} (t_board.checkWin(m_aiPlayer))\par
00195     \{\par
00196         {\cf19 return} WIN_SCORE;\par
00197     \}\par
00198 \par
00199     Player l_opponent = (m_aiPlayer == Player::Player1) ? Player::Player2 : Player::Player1;\par
00200     {\cf19 if} (t_board.checkWin(l_opponent))\par
00201     \{\par
00202         {\cf19 return} -WIN_SCORE;\par
00203     \}\par
00204 \par
00205     {\cf20 // Check score}\par
00206     {\cf18 int} l_score = 0;\par
00207 \par
00208     {\cf20 // Potential winning lines}\par
00209     l_score += evaluateLines(t_board, m_aiPlayer);\par
00210     l_score -= evaluateLines(t_board, l_opponent);\par
00211 \par
00212     {\cf20 // Piece positioning}\par
00213     l_score += evaluatePiecePlacement(t_board, m_aiPlayer);\par
00214     l_score -= evaluatePiecePlacement(t_board, l_opponent);\par
00215 \par
00216     {\cf20 // Only evaluate mobility in movement phase}\par
00217     {\cf19 if} (!t_board.isPlacementPhase()) \{\par
00218         l_score += evaluateMobility(t_board, m_aiPlayer);\par
00219         l_score -= evaluateMobility(t_board, l_opponent);\par
00220     \}\par
00221 \par
00222     {\cf19 return} l_score;\par
00223 \}\par
00224 \par
00225 {\cf18 int} AIOpponent::evaluateLines({\cf17 const} Board& t_board, Player t_player){\cf17  const}\par
00226 {\cf17 }\{\par
00227     {\cf18 int} l_score = 0;\par
00228     {\cf17 auto} lines = t_board.analyzeLines(t_player);\par
00229 \par
00230     {\cf19 for} ({\cf17 const} {\cf17 auto}& line : lines) \par
00231     \{\par
00232         {\cf19 if} (line.consecutiveCount == 3 && line.hasSpace)\par
00233         \{\par
00234             l_score += THREE_IN_ROW_OPEN;\par
00235         \}\par
00236         {\cf19 else} {\cf19 if} (line.consecutiveCount == 2 && line.hasSpace) \par
00237         \{\par
00238             l_score += TWO_IN_ROW_OPEN;\par
00239         \}\par
00240     \}\par
00241 \par
00242     {\cf19 return} l_score;\par
00243 \}\par
00244 \par
00245 {\cf18 int} AIOpponent::evaluatePiecePlacement({\cf17 const} Board& t_board, Player t_player){\cf17  const}\par
00246 {\cf17 }\{\par
00247     {\cf18 int} l_score = 0;\par
00248 \par
00249     {\cf20 // Bonus for controlling center (rows 1-3, cols 1-3)}\par
00250     {\cf19 for} ({\cf18 int} row = 1; row <= 3; ++row) \par
00251     \{\par
00252         {\cf19 for} ({\cf18 int} col = 1; col <= 3; ++col) \par
00253         \{\par
00254             {\cf17 const} Piece& l_piece = t_board.getPiece(row, col);\par
00255 \par
00256             {\cf19 if} (!l_piece.isEmpty() && l_piece.owner == t_player) \par
00257             \{\par
00258                 l_score += CENTER_CONTROL;\par
00259 \par
00260                 {\cf20 // Extra bonus for very center (2,2)}\par
00261                 {\cf19 if} (row == 2 && col == 2) \{\par
00262                     l_score += CENTER_CONTROL;\par
00263                 \}\par
00264             \}\par
00265         \}\par
00266     \}\par
00267 \par
00268     {\cf19 return} l_score;\par
00269 \}\par
00270 \par
00271 {\cf18 int} AIOpponent::evaluateMobility({\cf17 const} Board& t_board, Player t_player){\cf17  const}\par
00272 {\cf17 }\{\par
00273     {\cf18 int} l_score = 0;\par
00274 \par
00275     {\cf20 // Counts total number of available moves - Always better to have more options than less}\par
00276     {\cf19 for} ({\cf18 int} row = 0; row < Globals::GRID_SIZE; ++row)\par
00277     \{\par
00278         {\cf19 for} ({\cf18 int} col = 0; col < Globals::GRID_SIZE; ++col)\par
00279         \{\par
00280             {\cf17 const} Piece& l_piece = t_board.getPiece(row, col);\par
00281 \par
00282             {\cf19 if} (!l_piece.isEmpty() && l_piece.owner == t_player)\par
00283             \{\par
00284                 {\cf18 int} l_moveCount = t_board.getValidMoves(row, col).size();\par
00285                 l_score += l_moveCount * PIECE_MOBILITY;\par
00286             \}\par
00287         \}\par
00288     \}\par
00289 \par
00290     {\cf19 return} l_score;\par
00291 \}\par
