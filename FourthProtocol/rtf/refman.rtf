00565 {\cf18 void} GamePlayState::applyOpponentMove({\cf17 const} std::string& t_message)\par
00566 \{\par
00567     std::cout << {\cf22 "Applying opponent move: "} << t_message << {\cf22 "\\n"};\par
00568 \par
00569     {\cf20 // Parse message format: "PLACE|PieceType|Row|Col" or "MOVE|FromRow|FromCol|ToRow|ToCol"}\par
00570     {\cf18 size_t} firstDelim = t_message.find({\cf23 '|'});\par
00571 \par
00572     {\cf19 if} (firstDelim == std::string::npos)\par
00573     \{\par
00574         std::cout << {\cf22 "ERROR: Invalid message format\\n"};\par
00575         {\cf19 return};\par
00576     \}\par
00577 \par
00578     std::string messageType = t_message.substr(0, firstDelim);\par
00579 \par
00580     {\cf19 if} (messageType == {\cf22 "PLACE"}) \par
00581     \{\par
00582         {\cf20 // Parse: PLACE|Type|Row|Col}\par
00583         {\cf18 size_t} secondDelim = t_message.find({\cf23 '|'}, firstDelim + 1);\par
00584         {\cf18 size_t} thirdDelim = t_message.find({\cf23 '|'}, secondDelim + 1);\par
00585 \par
00586         {\cf19 if} (secondDelim == std::string::npos || thirdDelim == std::string::npos) \par
00587         \{\par
00588             std::cout << {\cf22 "ERROR: Invalid PLACE message\\n"};\par
00589             {\cf19 return};\par
00590         \}\par
00591 \par
00592         std::string typeStr = t_message.substr(firstDelim + 1, secondDelim - firstDelim - 1);\par
00593         std::string rowStr = t_message.substr(secondDelim + 1, thirdDelim - secondDelim - 1);\par
00594         std::string colStr = t_message.substr(thirdDelim + 1);\par
00595 \par
00596         {\cf20 // Convert type string to PieceType}\par
00597         PieceType type = PieceType::None;\par
00598 \par
00599         {\cf19 if} (typeStr == {\cf22 "Donkey"}) type = PieceType::Donkey;\par
00600         {\cf19 else} {\cf19 if} (typeStr == {\cf22 "Snake"}) type = PieceType::Snake;\par
00601         {\cf19 else} {\cf19 if} (typeStr == {\cf22 "Frog"}) type = PieceType::Frog;\par
00602 \par
00603         {\cf18 int} row = std::stoi(rowStr);\par
00604         {\cf18 int} col = std::stoi(colStr);\par
00605 \par
00606         {\cf20 // Apply opponent's placement}\par
00607         Player opponentPlayer = (m_localPlayer == Player::Player1) ? Player::Player2 : Player::Player1;\par
00608 \par
00609         {\cf19 if} (m_board.placePiece(row, col, type, opponentPlayer)) \par
00610         \{\par
00611             std::cout << {\cf22 "Opponent placed "} << typeStr << {\cf22 " at ("} << row << {\cf22 ", "} << col << {\cf22 ")\\n"};\par
00612 \par
00613             {\cf20 // Switch turn back to local player}\par
00614             m_currentTurn = m_localPlayer;\par
00615         \}\par
00616         {\cf19 else} \par
00617         \{\par
00618             std::cout << {\cf22 "ERROR: Opponent's move was invalid!\\n"};\par
00619         \}\par
00620     \}\par
00621     {\cf19 else} {\cf19 if} (messageType == {\cf22 "MOVE"})\par
00622     \{\par
00623         {\cf20 // Parse: MOVE|FromRow|FromCol|ToRow|ToCol}\par
00624         {\cf18 size_t} secondDelim = t_message.find({\cf23 '|'}, firstDelim + 1);\par
00625         {\cf18 size_t} thirdDelim = t_message.find({\cf23 '|'}, secondDelim + 1);\par
00626         {\cf18 size_t} fourthDelim = t_message.find({\cf23 '|'}, thirdDelim + 1);\par
00627 \par
00628         {\cf19 if} (secondDelim == std::string::npos || thirdDelim == std::string::npos || fourthDelim == std::string::npos)\par
00629         \{\par
00630             std::cout << {\cf22 "ERROR: Invalid MOVE message\\n"};\par
00631             {\cf19 return};\par
00632         \}\par
00633 \par
00634         {\cf18 int} fromRow = std::stoi(t_message.substr(firstDelim + 1, secondDelim - firstDelim - 1));\par
00635         {\cf18 int} fromCol = std::stoi(t_message.substr(secondDelim + 1, thirdDelim - secondDelim - 1));\par
00636         {\cf18 int} toRow = std::stoi(t_message.substr(thirdDelim + 1, fourthDelim - thirdDelim - 1));\par
00637         {\cf18 int} toCol = std::stoi(t_message.substr(fourthDelim + 1));\par
00638 \par
00639         {\cf20 // Apply opponent's move}\par
00640         {\cf19 if} (m_board.selectPieceForMove(fromRow, fromCol)) \par
00641         \{\par
00642             {\cf19 if} (m_board.movePiece(toRow, toCol)) \par
00643             \{\par
00644                 std::cout << {\cf22 "Opponent moved from ("} << fromRow << {\cf22 ", "} << fromCol << {\cf22 ") to ("} << toRow << {\cf22 ", "} << toCol << {\cf22 ")\\n"};\par
00645 \par
00646                 {\cf20 // Switch turn back to local player}\par
00647                 m_currentTurn = m_localPlayer;\par
00648             \}\par
00649             {\cf19 else} \par
00650             \{\par
00651                 std::cout << {\cf22 "ERROR: Opponent's move destination was invalid!\\n"};\par
00652             \}\par
00653         \}\par
00654         {\cf19 else} \par
00655         \{\par
00656             std::cout << {\cf22 "ERROR: Opponent couldn't select piece!\\n"};\par
00657         \}\par
00658     \}\par
00659     {\cf19 else} {\cf19 if} (messageType == {\cf22 "WIN"}) \par
00660     \{\par
00661         {\cf20 // Opponent won}\par
00662         std::string winnerName = t_message.substr(firstDelim + 1);\par
00663         m_winner = winnerName;\par
00664         std::cout << {\cf22 "Opponent won!\\n"};\par
00665     \}\par
00666 \}\par
}
