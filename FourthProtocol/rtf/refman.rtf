00336 sf::Color MainMenuState::getDifficultyButtonColor(AIDifficulty t_difficulty, {\cf18 bool} t_isSelected, {\cf18 bool} t_isHovered){\cf17  const}\par
00337 {\cf17 }\{\par
00338     {\cf20 // Base colors for each difficulty}\par
00339     sf::Color baseColor;\par
00340     {\cf19 switch} (t_difficulty) \par
00341     \{\par
00342     {\cf19 case} AIDifficulty::Easy:   baseColor = sf::Color(100.f, 255.f, 150.f); {\cf19 break};\par
00343     {\cf19 case} AIDifficulty::Medium: baseColor = sf::Color(200.f, 200.f, 50.f); {\cf19 break};\par
00344     {\cf19 case} AIDifficulty::Hard:   baseColor = sf::Color(255.f, 100.f, 100.f); {\cf19 break};\par
00345     \}\par
00346 \par
00347     {\cf20 // If selected, make brighter}\par
00348     {\cf19 if} (t_isSelected)\par
00349     \{\par
00350         {\cf19 return} baseColor;\par
00351     \}\par
00352 \par
00353     {\cf20 // If hovered (but not selected), make slightly brighter}\par
00354     {\cf19 if} (t_isHovered) \par
00355     \{\par
00356         {\cf19 return} sf::Color(\par
00357             std::min(255, baseColor.r + 50),\par
00358             std::min(255, baseColor.g + 50),\par
00359             std::min(255, baseColor.b + 50)\par
00360         );\par
00361     \}\par
00362 \par
00363     {\cf20 // Otherwise, make darker}\par
00364     {\cf19 return} sf::Color(baseColor.r / 2, baseColor.g / 2, baseColor.b / 2);\par
00365 \}\par
}
