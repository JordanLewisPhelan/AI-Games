00004 StateManager::StateManager()\par
00005 \{\par
00006 \}\par
00007 \par
00008 {\cf18 void} StateManager::changeState(std::unique_ptr<GameState> t_newState)\par
00009 \{\par
00010     {\cf19 if} (m_currentState)\par
00011     \{\par
00012         m_currentState->onExit();\par
00013     \}\par
00014 \par
00015     m_currentState = std::move(t_newState);\par
00016 \par
00017     {\cf19 if} (m_currentState)\par
00018     \{\par
00019         m_currentState->onEnter();\par
00020     \}\par
00021 \}\par
00022 \par
00023 {\cf18 void} StateManager::update(sf::Time t_deltaTime)\par
00024 \{\par
00025     {\cf19 if} (!m_currentState)\par
00026     \{\par
00027         {\cf19 return};\par
00028     \}\par
00029 \par
00030     m_currentState->update(t_deltaTime);\par
00031 \par
00032     {\cf20 // Check if state wants to transition}\par
00033     {\cf19 if} (m_currentState->shouldTransition())\par
00034     \{\par
00035         changeState(m_currentState->getNextState());\par
00036     \}\par
00037 \}\par
00038 \par
00039 {\cf18 void} StateManager::render(sf::RenderWindow& t_window)\par
00040 \{\par
00041     {\cf19 if} (!m_currentState)\par
00042     \{\par
00043         {\cf19 return};\par
00044     \}\par
00045 \par
00046     m_currentState->render(t_window);\par
00047 \}\par
00048 \par
00049 {\cf18 void} StateManager::handleEvent({\cf17 const} sf::Event& t_event)\par
00050 \{\par
00051     {\cf19 if} (!m_currentState)\par
00052     \{\par
00053         {\cf19 return};\par
00054     \}\par
00055 \par
00056     m_currentState->handleEvent(t_event);\par
00057 \}\par
00058 \par
00059 {\cf18 bool} StateManager::hasNoState(){\cf17  const}\par
00060 {\cf17 }\{\par
00061     {\cf19 return} m_currentState == {\cf17 nullptr};\par
00062 \}\par
}
