00018 {\cf18 void} LobbyState::onEnter()\par
00019 \{\par
00020     std::cout << {\cf22 "Entering Lobby State\\n"};\par
00021 \par
00022     {\cf20 // Title}\par
00023     m_titleText.setString({\cf22 "Network Lobby"});\par
00024     m_titleText.setCharacterSize(48);\par
00025     m_titleText.setFillColor(sf::Color::White);\par
00026     m_titleText.setPosition(sf::Vector2f(350.f, 100.f));\par
00027 \par
00028     {\cf20 // Status}\par
00029     m_statusText.setCharacterSize(32);\par
00030     m_statusText.setFillColor(sf::Color::Yellow);\par
00031     m_statusText.setPosition(sf::Vector2f(250.f, 250.f));\par
00032 \par
00033     {\cf19 if} (m_isHost) \par
00034     \{\par
00035         m_statusText.setString({\cf22 "Waiting for opponent to connect..."});\par
00036 \par
00037         {\cf20 // Show host's IP in console for easy sharing}\par
00038         {\cf17 auto} localIP = sf::IpAddress::getLocalAddress();\par
00039         {\cf19 if} (localIP.has_value()) \{\par
00040             std::cout << {\cf22 "\\n========================================\\n"};\par
00041             std::cout << {\cf22 "Your IP Address: "} << localIP.value().toString() << {\cf22 "\\n"};\par
00042             std::cout << {\cf22 "Tell your opponent to connect to this IP\\n"};\par
00043             std::cout << {\cf22 "========================================\\n\\n"};\par
00044         \}\par
00045     \}\par
00046     {\cf19 else} \par
00047     \{\par
00048         m_statusText.setString({\cf22 "Connecting to host..."});\par
00049     \}\par
00050 \par
00051     {\cf20 // Instructions}\par
00052     m_instructionText.setString({\cf22 "Press SPACE to start game\\nPress ESC to cancel"});\par
00053     m_instructionText.setCharacterSize(24);\par
00054     m_instructionText.setFillColor(sf::Color(150, 150, 150));  {\cf20 // Gray initially}\par
00055     m_instructionText.setPosition(sf::Vector2f(300.f, 400.f));\par
00056 \}\par
00057 \par
00058 {\cf18 void} LobbyState::onExit()\par
00059 \{\par
00060     std::cout << {\cf22 "Exiting Lobby State\\n"};\par
00061 \}\par
00062 \par
00063 {\cf18 void} LobbyState::update(sf::Time t_dt)\par
00064 \{\par
00065     {\cf20 // Update connection status}\par
00066     m_networkManager->updateConnection();\par
00067 \par
00068     ConnectionState connState = m_networkManager->getConnectionState();\par
00069 \par
00070     {\cf20 // Update status text based on connection state}\par
00071     {\cf19 if} (connState == ConnectionState::Connected && !m_connectionEstablished) \par
00072     \{\par
00073         m_connectionEstablished = {\cf17 true};\par
00074         m_statusText.setString({\cf22 "Connected! Press SPACE to start"});\par
00075         m_statusText.setFillColor(sf::Color::Green);\par
00076         m_instructionText.setFillColor(sf::Color::White);  {\cf20 // Make instructions visible}\par
00077 \par
00078         {\cf20 // Send READY message}\par
00079         m_networkManager->sendMessage({\cf22 "READY"});\par
00080     \}\par
00081     {\cf19 else} {\cf19 if} (connState == ConnectionState::Failed) \par
00082     \{\par
00083         std::cout << {\cf22 "Connection failed! Returning to menu\\n"};\par
00084         m_nextState = std::make_unique<MainMenuState>(m_sharedFont, m_networkManager);\par
00085         m_transitionRequested = {\cf17 true};\par
00086         {\cf19 return};\par
00087     \}\par
00088     {\cf19 else} {\cf19 if} (connState == ConnectionState::Listening)\par
00089     \{\par
00090         m_statusText.setString({\cf22 "Waiting for opponent..."});\par
00091     \}\par
00092     {\cf19 else} {\cf19 if} (connState == ConnectionState::Connecting)\par
00093     \{\par
00094         m_statusText.setString({\cf22 "Connecting..."});\par
00095     \}\par
00096 \par
00097     {\cf20 // Check for messages}\par
00098     {\cf17 auto} messageOpt = m_networkManager->receiveMessage();\par
00099     {\cf19 if} (messageOpt.has_value()) \par
00100     \{\par
00101         std::string message = messageOpt.value();\par
00102 \par
00103         {\cf19 if} (message == {\cf22 "READY"} || message == {\cf22 "PING"})\par
00104         \{\par
00105             std::cout << {\cf22 "Opponent is ready!\\n"};\par
00106             {\cf19 if} (!m_connectionEstablished)\par
00107             \{\par
00108                 m_connectionEstablished = {\cf17 true};\par
00109                 m_statusText.setString({\cf22 "Connected! Press SPACE to start"});\par
00110                 m_statusText.setFillColor(sf::Color::Green);\par
00111                 m_instructionText.setFillColor(sf::Color::White);\par
00112             \}\par
00113         \}\par
00114         {\cf19 else} {\cf19 if} (message == {\cf22 "START"}) \par
00115         \{\par
00116             std::cout << {\cf22 "Game starting!\\n"};\par
00117             {\cf20 // Transition to game - pass NetworkManager!}\par
00118             {\cf17 auto} gameState = std::make_unique<GamePlayState>(\par
00119                 m_sharedFont,\par
00120                 GameMode::VsNetworked,\par
00121                 AIDifficulty::Medium,\par
00122                 m_networkManager\par
00123             );\par
00124             {\cf20 // TODO: Pass NetworkManager to GamePlayState}\par
00125             m_nextState = std::move(gameState);\par
00126             m_transitionRequested = {\cf17 true};\par
00127         \}\par
00128     \}\par
00129 \}\par
00130 \par
00131 {\cf18 void} LobbyState::render(sf::RenderWindow& t_window)\par
00132 \{\par
00133     t_window.draw(m_titleText);\par
00134     t_window.draw(m_statusText);\par
00135     t_window.draw(m_instructionText);\par
00136 \}\par
00137 \par
00138 {\cf18 void} LobbyState::handleEvent({\cf17 const} sf::Event& t_event)\par
00139 \{\par
00140     {\cf19 if} ({\cf17 const} {\cf17 auto}* keyPress = t_event.getIf<sf::Event::KeyPressed>())\par
00141     \{\par
00142         {\cf20 // ESC to cancel and return to menu}\par
00143         {\cf19 if} (keyPress->code == sf::Keyboard::Key::Escape)\par
00144         \{\par
00145             std::cout << {\cf22 "Canceling connection...\\n"};\par
00146             m_networkManager->disconnect();\par
00147             m_nextState = std::make_unique<MainMenuState>(m_sharedFont, m_networkManager);\par
00148             m_transitionRequested = {\cf17 true};\par
00149         \}\par
00150 \par
00151         {\cf20 // SPACE to start (only if connected)}\par
00152         {\cf19 if} (keyPress->code == sf::Keyboard::Key::Space && m_connectionEstablished)\par
00153         \{\par
00154             std::cout << {\cf22 "Starting game!\\n"};\par
00155 \par
00156             {\cf20 // Send START message}\par
00157             m_networkManager->sendMessage({\cf22 "START"});\par
00158 \par
00159             {\cf20 // Transition to game }\par
00160             {\cf17 auto} gameState = std::make_unique<GamePlayState>(\par
00161                 m_sharedFont,\par
00162                 GameMode::VsNetworked,\par
00163                 AIDifficulty::Medium,\par
00164                 m_networkManager\par
00165             );\par
00166             m_nextState = std::move(gameState);\par
00167             m_transitionRequested = {\cf17 true};\par
00168         \}\par
00169     \}\par
00170 \}\par
00171 \par
00172 {\cf18 bool} LobbyState::shouldTransition(){\cf17  const}\par
00173 {\cf17 }\{\par
00174     {\cf19 return} m_transitionRequested;\par
00175 \}\par
00176 \par
00177 std::unique_ptr<GameState> LobbyState::getNextState()\par
00178 \{\par
00179     m_transitionRequested = {\cf17 false};\par
00180     {\cf19 return} std::move(m_nextState);\par
00181 \}\par
}
