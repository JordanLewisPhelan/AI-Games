00294 {\cf20 // ===================== AI DECISION MAKING =================}\par
00295 \par
00296 AIMove AIOpponent::calculateBestMove(Board& t_board)\par
00297 \{\par
00298     std::cout << {\cf22 "AI thinking (depth "} << m_maxDepth << {\cf22 ")...\\n"};\par
00299 \par
00300     std::vector<AIMove> possibleMoves = getAllPossibleMoves(t_board, m_aiPlayer);\par
00301 \par
00302     {\cf19 if} (possibleMoves.empty()) \{\par
00303         std::cout << {\cf22 "ERROR: AI has no valid moves!\\n"};\par
00304         {\cf19 return} AIMove();\par
00305     \}\par
00306 \par
00307     std::cout << {\cf22 "Evaluating "} << possibleMoves.size() << {\cf22 " possible moves...\\n"};\par
00308 \par
00309     {\cf20 // Easy mode: Add randomness}\par
00310     {\cf19 if} (m_difficulty == AIDifficulty::Easy) \{\par
00311         {\cf17 static} std::random_device rd;\par
00312         {\cf17 static} std::mt19937 gen(rd());\par
00313         std::uniform_int_distribution<> dis(0, 99);\par
00314 \par
00315         {\cf19 if} (dis(gen) < 40) \{  {\cf20 // 40% chance of random move}\par
00316             std::uniform_int_distribution<> moveDis(0, possibleMoves.size() - 1);\par
00317             std::cout << {\cf22 "AI making random move (Easy mode)\\n"};\par
00318             {\cf19 return} possibleMoves[moveDis(gen)];\par
00319         \}\par
00320     \}\par
00321 \par
00322     AIMove bestMove;\par
00323     {\cf18 int} bestScore = std::numeric_limits<int>::min();\par
00324     {\cf18 int} alpha = std::numeric_limits<int>::min();\par
00325     {\cf18 int} beta = std::numeric_limits<int>::max();\par
00326 \par
00327     {\cf19 for} ({\cf18 size_t} i = 0; i < possibleMoves.size(); ++i) \{\par
00328         {\cf17 const} AIMove& move = possibleMoves[i];\par
00329 \par
00330         {\cf20 // Apply move}\par
00331         Board::MoveBackup backup;\par
00332         {\cf19 if} (move.isInPlacement) \{\par
00333             backup = t_board.simulatePlacement(move.pieceType, move.row, move.col, m_aiPlayer);\par
00334         \}\par
00335         {\cf19 else} \{\par
00336             backup = t_board.simulateMove(move.fromRow, move.fromCol, move.toRow, move.toCol);\par
00337         \}\par
00338 \par
00339         {\cf20 // Evaluate}\par
00340         {\cf18 int} score = miniMax(t_board, m_maxDepth - 1, alpha, beta, {\cf17 false});\par
00341 \par
00342         {\cf20 // Undo}\par
00343         t_board.undoMove(backup);\par
00344 \par
00345         std::cout << {\cf22 "  Move "} << (i + 1) << {\cf22 "/"} << possibleMoves.size() << {\cf22 " - Score: "} << score << {\cf22 "\\n"};\par
00346 \par
00347         {\cf19 if} (score > bestScore) \{\par
00348             bestScore = score;\par
00349             bestMove = move;\par
00350         \}\par
00351 \par
00352         alpha = std::max(alpha, score);\par
00353     \}\par
00354 \par
00355     std::cout << {\cf22 "AI chose move with score: "} << bestScore << {\cf22 "\\n"};\par
00356     {\cf19 return} bestMove;\par
00357 \}\par
00358 \par
}
