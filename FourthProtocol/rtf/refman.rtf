00726 std::vector<Board::LineInfo> Board::analyzeLines(Player t_player){\cf17  const}\par
00727 {\cf17 }\{\par
00728     std::vector<LineInfo> lines;\par
00729 \par
00730     {\cf20 // Helper lambda to analyze a line in any direction}\par
00731     {\cf17 auto} analyzeLine = [&]({\cf18 int} startRow, {\cf18 int} startCol, {\cf18 int} deltaRow, {\cf18 int} deltaCol) \{\par
00732         LineInfo info;\par
00733 \par
00734         {\cf19 for} ({\cf18 int} i = 0; i < 4; ++i) \{\par
00735             {\cf18 int} row = startRow + i * deltaRow;\par
00736             {\cf18 int} col = startCol + i * deltaCol;\par
00737 \par
00738             {\cf17 const} Piece& piece = m_grid[row][col];\par
00739 \par
00740             {\cf19 if} (piece.isEmpty()) \{\par
00741                 info.hasSpace = {\cf17 true};\par
00742             \}\par
00743             {\cf19 else} {\cf19 if} (piece.owner == t_player) \{\par
00744                 info.consecutiveCount++;\par
00745             \}\par
00746             {\cf19 else} \{\par
00747                 {\cf20 // Opponent piece blocks this line}\par
00748                 info.isBlocked = {\cf17 true};\par
00749                 {\cf19 break};\par
00750             \}\par
00751         \}\par
00752 \par
00753         {\cf20 // Only add lines that have potential (not completely blocked)}\par
00754         {\cf19 if} (info.consecutiveCount > 0 && !info.isBlocked) \{\par
00755             lines.push_back(info);\par
00756         \}\par
00757         \};\par
00758 \par
00759     {\cf20 // Check all horizontal lines}\par
00760     {\cf19 for} ({\cf18 int} row = 0; row < Globals::GRID_SIZE; ++row) \{\par
00761         {\cf19 for} ({\cf18 int} col = 0; col <= Globals::GRID_SIZE - 4; ++col) \{\par
00762             analyzeLine(row, col, 0, 1);\par
00763         \}\par
00764     \}\par
00765 \par
00766     {\cf20 // Check all vertical lines}\par
00767     {\cf19 for} ({\cf18 int} col = 0; col < Globals::GRID_SIZE; ++col) \{\par
00768         {\cf19 for} ({\cf18 int} row = 0; row <= Globals::GRID_SIZE - 4; ++row) \{\par
00769             analyzeLine(row, col, 1, 0);\par
00770         \}\par
00771     \}\par
00772 \par
00773     {\cf20 // Check all diagonal lines (top-left to bottom-right)}\par
00774     {\cf19 for} ({\cf18 int} row = 0; row <= Globals::GRID_SIZE - 4; ++row) \{\par
00775         {\cf19 for} ({\cf18 int} col = 0; col <= Globals::GRID_SIZE - 4; ++col) \{\par
00776             analyzeLine(row, col, 1, 1);\par
00777         \}\par
00778     \}\par
00779 \par
00780     {\cf20 // Check all diagonal lines (top-right to bottom-left)}\par
00781     {\cf19 for} ({\cf18 int} row = 0; row <= Globals::GRID_SIZE - 4; ++row) \{\par
00782         {\cf19 for} ({\cf18 int} col = 3; col < Globals::GRID_SIZE; ++col) \{\par
00783             analyzeLine(row, col, 1, -1);\par
00784         \}\par
00785     \}\par
00786 \par
00787     {\cf19 return} lines;\par
00788 \}\par
