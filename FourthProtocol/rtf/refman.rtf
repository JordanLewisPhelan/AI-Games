00191 {\cf18 void} GamePlayState::handleEvent({\cf17 const} sf::Event& t_event)\par
00192 \{\par
00193     {\cf20 // ESC toggles pause}\par
00194     {\cf19 if} ({\cf17 const} {\cf17 auto}* keyPress = t_event.getIf<sf::Event::KeyPressed>())\par
00195     \{\par
00196         {\cf19 if} (keyPress->code == sf::Keyboard::Key::Escape && m_winner.empty())\par
00197         \{\par
00198             m_isPaused = !m_isPaused;\par
00199             std::cout << (m_isPaused ? {\cf22 "Game paused\\n"} : {\cf22 "Game resumed\\n"});\par
00200             {\cf19 return};\par
00201         \}\par
00202     \}\par
00203 \par
00204     {\cf19 if} (m_isPaused) \{\par
00205         handlePauseInput(t_event);\par
00206     \}\par
00207     {\cf19 else} \{\par
00208         handleGameInput(t_event);\par
00209     \}\par
00210 \}\par
00211 \par
00212 {\cf18 void} GamePlayState::handleGameInput({\cf17 const} sf::Event& t_event)\par
00213 \{\par
00214     {\cf20 // If game is over, any click returns to menu}\par
00215     {\cf19 if} (!m_winner.empty())\par
00216     \{\par
00217         {\cf19 if} (t_event.getIf<sf::Event::MouseButtonPressed>())\par
00218         \{\par
00219             std::cout << {\cf22 "Returning to main menu\\n"};\par
00220             m_nextState = std::make_unique<MainMenuState>(m_sharedFont, m_networkManager);\par
00221             m_transitionRequested = {\cf17 true};\par
00222         \}\par
00223         {\cf19 return};\par
00224     \}\par
00225 \par
00226     {\cf19 if} (!isMyTurn()) \par
00227         {\cf19 return};\par
00228 \par
00229 \par
00230     {\cf20 // Handle mouse clicks for game interaction}\par
00231     {\cf19 if} ({\cf17 const} {\cf17 auto}* mousePress = t_event.getIf<sf::Event::MouseButtonPressed>())\par
00232     \{\par
00233         {\cf19 if} (mousePress->button == sf::Mouse::Button::Left)\par
00234         \{\par
00235             sf::Vector2f mousePos({\cf17 static_cast<}{\cf18 float}{\cf17 >}(mousePress->position.x),\par
00236                 {\cf17 static_cast<}{\cf18 float}{\cf17 >}(mousePress->position.y));\par
00237 \par
00238             {\cf20 // PLACEMENT PHASE}\par
00239             {\cf19 if} (m_board.isPlacementPhase())\par
00240             \{\par
00241                 {\cf20 // First check if clicking on unplaced piece selector}\par
00242                 PieceType clickedPiece = m_board.getClickedUnplacedPiece(mousePos, m_board.getCurrentPlayer());\par
00243                 {\cf19 if} (clickedPiece != PieceType::None)\par
00244                 \{\par
00245                     m_board.selectPieceType(clickedPiece);\par
00246                     std::cout << {\cf22 "Selected piece type: "} << (int)clickedPiece << {\cf22 "\\n"};\par
00247                 \}\par
00248                 {\cf20 // Then check if clicking on board to place}\par
00249                 {\cf19 else} {\cf19 if} (m_board.isPositionOnBoard(mousePos))\par
00250                 \{\par
00251                     {\cf17 auto} [row, col] = m_board.screenToGrid(mousePos);\par
00252                     PieceType selectedType = m_board.getSelectedPieceType();\par
00253 \par
00254                     {\cf19 if} (selectedType != PieceType::None)\par
00255                     \{\par
00256                         {\cf19 if} (m_board.placePiece(row, col, selectedType, m_board.getCurrentPlayer()))\par
00257                         \{\par
00258                             std::cout << {\cf22 "Placed piece at ("} << row << {\cf22 ", "} << col << {\cf22 ")\\n"};\par
00259 \par
00260                             {\cf19 if} (m_mode == GameMode::VsNetworked)\par
00261                             \{\par
00262                                 {\cf20 // Send move over network}\par
00263                                 std::string pieceTypeName;\par
00264                                 {\cf19 switch} (selectedType) \{\par
00265                                 {\cf19 case} PieceType::Donkey: pieceTypeName = {\cf22 "Donkey"}; {\cf19 break};\par
00266                                 {\cf19 case} PieceType::Snake: pieceTypeName = {\cf22 "Snake"}; {\cf19 break};\par
00267                                 {\cf19 case} PieceType::Frog: pieceTypeName = {\cf22 "Frog"}; {\cf19 break};\par
00268                                 {\cf19 default}: pieceTypeName = {\cf22 "Unknown"}; {\cf19 break};\par
00269                                 \}\par
00270 \par
00271                                 std::string message = {\cf22 "PLACE|"} + pieceTypeName + {\cf22 "|"} +\par
00272                                     std::to_string(row) + {\cf22 "|"} + std::to_string(col);\par
00273 \par
00274                                 sendMove(message);\par
00275                             \}\par
00276 \par
00277                             {\cf20 // Switch turn to opponent}\par
00278                             m_currentTurn = (m_currentTurn == Player::Player1) ? Player::Player2 : Player::Player1;\par
00279 \par
00280 \par
00281                             {\cf20 // Reset selection after successful placement}\par
00282                             m_board.selectPieceType(PieceType::None);\par
00283                         \}\par
00284                         {\cf19 else}\par
00285                         \{\par
00286                             std::cout << {\cf22 "Cannot place piece at ("} << row << {\cf22 ", "} << col << {\cf22 ")\\n"};\par
00287                         \}\par
00288                     \}\par
00289                     {\cf19 else}\par
00290                     \{\par
00291                         std::cout << {\cf22 "No piece type selected!\\n"};\par
00292                     \}\par
00293                 \}\par
00294             \}\par
00295 \par
00296             {\cf20 // MOVEMENT PHASE}\par
00297             {\cf19 else}\par
00298             \{\par
00299                 {\cf19 if} (m_board.isPositionOnBoard(mousePos))\par
00300                 \{\par
00301                     {\cf17 auto} [row, col] = m_board.screenToGrid(mousePos);\par
00302 \par
00303                     {\cf20 // If no piece is selected, try to select one}\par
00304                     {\cf19 if} (!m_board.isPieceSelected())\par
00305                     \{\par
00306                         {\cf19 if} (m_board.selectPieceForMove(row, col))\par
00307                         \{\par
00308                             std::cout << {\cf22 "Selected piece at ("} << row << {\cf22 ", "} << col << {\cf22 ")\\n"};\par
00309                         \}\par
00310                     \}\par
00311                     {\cf20 // If piece is selected, try to move it}\par
00312                     {\cf19 else}\par
00313                     \{\par
00314                         {\cf19 if} (m_board.movePiece(row, col))\par
00315                         \{\par
00316                             std::cout << {\cf22 "Moved piece to ("} << row << {\cf22 ", "} << col << {\cf22 ")\\n"};\par
00317 \par
00318                             {\cf19 if} (m_mode == GameMode::VsNetworked)\par
00319                             \{\par
00320                                 std::string message = {\cf22 "MOVE|"} + std::to_string(row) + {\cf22 "|"} +\par
00321                                     std::to_string(col) + {\cf22 "|"} +\par
00322                                     std::to_string(row) + {\cf22 "|"} + std::to_string(col);\par
00323 \par
00324                                 sendMove(message);\par
00325                             \}\par
00326 \par
00327                             {\cf20 // Switch turn to opponent}\par
00328                             m_currentTurn = (m_currentTurn == Player::Player1) ? Player::Player2 : Player::Player1;\par
00329 \par
00330                         \}\par
00331                         {\cf19 else}\par
00332                         \{\par
00333                             {\cf20 // Click elsewhere - deselect or select new piece}\par
00334                             m_board.deselectPiece();\par
00335                             m_board.selectPieceForMove(row, col);\par
00336                         \}\par
00337                     \}\par
00338                 \}\par
00339             \}\par
00340         \}\par
00341     \}\par
00342 \}\par
